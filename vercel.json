{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "adnilo.co.uk"
        }
      ],
      "destination": "https://www.adnilo.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/packages.html",
      "destination": "/packages",
      "permanent": true
    },
    {
      "source": "/packages/",
      "destination": "/packages",
      "permanent": true
    },
    {
      "source": "/google-ads",
      "destination": "/google-ads.html",
      "permanent": true
    },
    {
      "source": "/google-ads/",
      "destination": "/google-ads.html",
      "permanent": true
    },
    {
      "source": "/google-search-ads",
      "destination": "/google-search-ads.html",
      "permanent": true
    },
    {
      "source": "/google-search-ads/",
      "destination": "/google-search-ads.html",
      "permanent": true
    },
    {
      "source": "/google-ads-audit",
      "destination": "/google-ads-audit.html",
      "permanent": true
    },
    {
      "source": "/google-ads-audit/",
      "destination": "/google-ads-audit.html",
      "permanent": true
    },
    {
      "source": "/fix-google-ads",
      "destination": "/fix-google-ads.html",
      "permanent": true
    },
    {
      "source": "/fix-google-ads/",
      "destination": "/fix-google-ads.html",
      "permanent": true
    },
    {
      "source": "/landing-pages",
      "destination": "/landing-pages.html",
      "permanent": true
    },
    {
      "source": "/landing-pages/",
      "destination": "/landing-pages.html",
      "permanent": true
    },
    {
      "source": "/conversion-tracking",
      "destination": "/conversion-tracking.html",
      "permanent": true
    },
    {
      "source": "/conversion-tracking/",
      "destination": "/conversion-tracking.html",
      "permanent": true
    },
    {
      "source": "/meta-ads",
      "destination": "/meta-ads.html",
      "permanent": true
    },
    {
      "source": "/meta-ads/",
      "destination": "/meta-ads.html",
      "permanent": true
    },
    {
      "source": "/retargeting-ads",
      "destination": "/retargeting-ads.html",
      "permanent": true
    },
    {
      "source": "/retargeting-ads/",
      "destination": "/retargeting-ads.html",
      "permanent": true
    },
    {
      "source": "/local-lead-generation",
      "destination": "/local-lead-generation.html",
      "permanent": true
    },
    {
      "source": "/local-lead-generation/",
      "destination": "/local-lead-generation.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/packages",
      "destination": "/packages.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
